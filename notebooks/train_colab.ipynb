  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Installation des dépendances\n",
    "!pip install -q transformers peft trl bitsandbytes accelerate datasets huggingface_hub wandb"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Clone du repo GitHub\n",
    "!git clone https://github.com/NaimMG/AeroLLM.git\n",
    "%cd AeroLLM"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Connexion HuggingFace (pour sauvegarder le modèle)\n",
    "from huggingface_hub import login\n",
    "login()  # Entrer le token HF quand demandé"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Préparation du dataset\n",
    "!python src/prepare_data.py"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- FINE-TUNING QLORA ---\n",
    "import json, torch\n",
    "from datasets import Dataset\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig, TrainingArguments\n",
    "from peft import LoraConfig, get_peft_model\n",
    "from trl import SFTTrainer\n",
    "\n",
    "MODEL_ID = 'meta-llama/Llama-3.2-3B-Instruct'\n",
    "OUTPUT_DIR = './outputs/aerollm-qlora'\n",
    "HF_REPO = 'NaimMG/aerollm-llama3.2-3b-asrs'\n",
    "\n",
    "print('✅ Config OK')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Chargement du dataset\n",
    "with open('data/processed/train.json') as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "def format_prompt(item):\n",
    "    return {\n",
    "        'text': f\"\"\"<|begin_of_text|><|start_header_id|>system<|end_header_id|>\n",
    "{item['instruction']}<|eot_id|><|start_header_id|>user<|end_header_id|>\n",
    "{item['input']}<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n",
    "{item['output']}<|eot_id|>\"\"\"\n",
    "    }\n",
    "\n",
    "# Split train/eval 90/10\n",
    "split = int(len(data) * 0.9)\n",
    "train_data = Dataset.from_list([format_prompt(d) for d in data[:split]])\n",
    "eval_data  = Dataset.from_list([format_prompt(d) for d in data[split:]])\n",
    "\n",
    "print(f'Train: {len(train_data)} | Eval: {len(eval_data)}')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Quantization 4-bit QLoRA\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type='nf4',\n",
    "    bnb_4bit_compute_dtype=torch.bfloat16,\n",
    "    bnb_4bit_use_double_quant=True\n",
    ")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_ID,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map='auto'\n",
    ")\n",
    "model.config.use_cache = False\n",
    "\n",
    "print('✅ Modèle chargé en 4-bit')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Configuration LoRA\n",
    "lora_config = LoraConfig(\n",
    "    r=16,\n",
    "    lora_alpha=32,\n",
    "    target_modules=['q_proj', 'v_proj', 'k_proj', 'o_proj'],\n",
    "    lora_dropout=0.05,\n",
    "    bias='none',\n",
    "    task_type='CAUSAL_LM'\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, lora_config)\n",
    "model.print_trainable_parameters()\n",
    "# Attendu : ~1-2% des paramètres entraînables"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Arguments d'entraînement\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=OUTPUT_DIR,\n",
    "    num_train_epochs=2,\n",
    "    per_device_train_batch_size=2,\n",
    "    gradient_accumulation_steps=4,\n",
    "    learning_rate=2e-4,\n",
    "    fp16=True,\n",
    "    logging_steps=25,\n",
    "    evaluation_strategy='steps',\n",
    "    eval_steps=100,\n",
    "    save_steps=100,\n",
    "    save_total_limit=2,\n",
    "    load_best_model_at_end=True,\n",
    "    push_to_hub=True,\n",
    "    hub_model_id=HF_REPO,\n",
    "    hub_strategy='checkpoint',\n",
    "    report_to='none',\n",
    "    warmup_ratio=0.03,\n",
    "    lr_scheduler_type='cosine'\n",
    ")\n",
    "\n",
    "print('✅ Training args OK')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Lancement du fine-tuning\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=train_data,\n",
    "    eval_dataset=eval_data,\n",
    "    dataset_text_field='text',\n",
    "    max_seq_length=512,\n",
    "    tokenizer=tokenizer\n",
    ")\n",
    "\n",
    "print('🚀 Début du fine-tuning...')\n",
    "trainer.train()\n",
    "print('✅ Fine-tuning terminé !')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Sauvegarde finale sur HuggingFace Hub\n",
    "trainer.push_to_hub()\n",
    "tokenizer.push_to_hub(HF_REPO)\n",
    "print(f'✅ Modèle publié : https://huggingface.co/{HF_REPO}')"
   ],
   "outputs": [], "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Test rapide du modèle fine-tuné\n",
    "from peft import PeftModel\n",
    "\n",
    "test_input = \"\"\"Aéronef : B737-800\n",
    "Phase de vol : Final Approach\n",
    "Rapport : During final approach runway 28L, GPWS terrain warning activated at 500ft AGL. \n",
    "Crew executed go-around immediately. Investigation revealed incorrect QNH setting.\"\"\"\n",
    "\n",
    "prompt = f\"\"\"<|begin_of_text|><|start_header_id|>system<|end_header_id|>\n",
    "Tu es un expert en sécurité aéronautique certifié FAA/EASA. Analyse ce rapport d'incident ASRS.<|eot_id|>\n",
    "<|start_header_id|>user<|end_header_id|>\n",
    "{test_input}<|eot_id|>\n",
    "<|start_header_id|>assistant<|end_header_id|>\"\"\"\n",
    "\n",
    "inputs = tokenizer(prompt, return_tensors='pt').to('cuda')\n",
    "outputs = model.generate(**inputs, max_new_tokens=300, temperature=0.7, do_sample=True)\n",
    "print(tokenizer.decode(outputs[0], skip_special_tokens=True))"
   ],
   "outputs": [], "execution_count": null
  }
 ],
